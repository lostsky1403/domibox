# DomiBox Phase 1A — environment TEMPLATE.
# Copy to `.env` only in your local working copy. NEVER commit a populated `.env`.
# NO CREDENTIALS, API TOKENS OR PASSWORDS BELONG IN THIS FILE.
#
# SMTP host bind. Loopback is the safe default.
# REQUIRES OWNER APPROVAL to change to 0.0.0.0 (plus Tencent SG + UFW TCP/25).
POC_SMTP_HOST_IP=127.0.0.1

# Host port for the loopback-only setup wizard / management API.
# Reach it via: ssh -L 8080:127.0.0.1:8080 vps-tencent3b
POC_ADMIN_HOST_PORT=8080

# PoC default: do not restart automatically after an experiment.
POC_RESTART_POLICY=no
